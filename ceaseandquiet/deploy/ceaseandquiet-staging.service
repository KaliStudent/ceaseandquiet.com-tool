[Unit]
Description=Cease and Quiet restricted staging
After=network.target

[Service]
Type=simple
DynamicUser=true
ExecStart=/opt/ceaseandquiet-staging/cq-staging
Environment=CQ_STAGING_HOST=abcw.xyz:8443
Environment=CQ_STAGING_USER=reviewer
Environment=CQ_STAGING_PASSWORD_SHA256_FILE=%d/auth.sha256
Environment=CQ_STAGING_TLS_CERT_FILE=%d/tls.pem
Environment=CQ_STAGING_TLS_KEY_FILE=%d/tls.pem
LoadCredential=auth.sha256:/etc/ceaseandquiet-staging/auth.sha256
LoadCredential=tls.pem:/var/cpanel/ssl/apache_tls/abcw.xyz/combined
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SocketBindDeny=any
SocketBindAllow=tcp:8443
MemoryMax=192M
CPUQuota=50%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
